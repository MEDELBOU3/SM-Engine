{
  "name": "sm-engine",
  "productName": "SM Engine",
  "version": "1.0.1",
  "description": "SM Engine - Advanced Web 3D Modeling & Game Editor",
  "main": "electron-main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MEDELBOU3/SM-Engine.git"
  },
  "scripts": {
    "start": "electron .",
    "start:website": "powershell -Command \"Start-Process .\\SM-Engine-intro-website\\index.html\"",
    "sync:offline-assets": "node tools/mirror-offline-assets.js",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-tests.ps1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64 nsis portable zip",
    "dist:publish": "electron-builder --win --publish always",
    "build:sculpt-wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-sculpt-wasm.ps1",
    "build:native-water-wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-water-wasm.ps1"
  },
  "keywords": [
    "3d",
    "editor",
    "modeling",
    "game",
    "engine"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.smengine.app",
    "productName": "SM Engine",
    "executableName": "SM Engine",
    "directories": {
      "output": "dist-win"
    },
    "files": [
      "**/*",
      "assets/**/*",
      "sculpting/*.js",
      "!dist*/**/*",
      "!trash-files/**/*",
      "!screenshots/**/*",
      "!SM-Engine-intro-website/**/*",
      "!launcher/**/*",
      "!companion-apps/**/*",
      "!video-editing-backup/**/*",
      "!tests/**/*",
      "!tools/*.ps1",
      "!.tmp*/**/*"
    ],
    "compression": "maximum",
    "win": {
      "icon": "assets/icons/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "artifactName": "SM-Engine-Setup-${version}-x64.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/logo.ico",
      "uninstallerIcon": "assets/icons/logo.ico",
      "installerHeaderIcon": "assets/icons/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SM Engine"
    },
    "portable": {
      "artifactName": "SM-Engine-Portable-${version}-x64.exe"
    },
    "zip": {
      "artifactName": "SM-Engine-${version}-win-x64.zip"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MEDELBOU3",
        "repo": "SM-Engine"
      }
    ]
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@vscode/codicons": "^0.0.45",
    "acorn": "^8.16.0",
    "ammo.js": "^0.0.10",
    "boxicons": "^2.1.4",
    "cannon": "^0.6.2",
    "cannon-es": "^0.20.0",
    "codemirror": "^6.0.2",
    "d3-delaunay": "^6.0.4",
    "dat.gui": "^0.7.9",
    "es-module-shims": "^2.8.0",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.14.2",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lil-gui": "^0.21.0",
    "litegraph.js": "^0.7.18",
    "noisejs": "^2.1.0",
    "remixicon": "^4.9.1",
    "simplex-noise": "^4.0.3",
    "stats.js": "^0.17.0",
    "tern": "^0.24.3",
    "three": "^0.159.0",
    "three-csg-ts": "^3.2.0",
    "three-mesh-bvh": "^0.9.9",
    "three-spritetext": "^1.10.0",
    "three-subdivide": "^1.1.5",
    "vis-network": "^10.0.2"
  }
}
